# Replace HUB_PUBLIC_IP after the challenge server has issued hub-agents-ip.
limit_req_zone $binary_remote_addr zone=hub_agents_requests:5m rate=10r/s;

server {
    listen 80;
    server_name HUB_PUBLIC_IP;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/hub-agents-acme/webroot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 404; }
    access_log off;
}

server {
    listen 9443 ssl;
    server_name HUB_PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/hub-agents-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hub-agents-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 17m;
    client_body_timeout 30s;
    location /v1/ {
        limit_req zone=hub_agents_requests burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
    location / { return 404; }
}
