        <mxCell id="e-ov-actions-ov-finish" source="ov-actions" target="ov-finish" value="核验回执" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-ov-actions-ov-undo" source="ov-actions" target="ov-undo" value="撤销 / 补偿" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;startArrow=block;">
