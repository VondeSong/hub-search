        </mxCell>
        <mxCell id="ov-goal" value="&lt;b&gt;1 用户委托 / 有效目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;要求、范围、完成标准有版本&lt;br&gt;&lt;br&gt;追加保留原文及替代关系&lt;br&gt;&lt;br&gt;目标变化使依赖重新核验" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="240" width="480" height="230" />
        </mxCell>
        <mxCell id="ov-run" value="&lt;b&gt;模型自主执行&lt;/b&gt;&lt;br&gt;&lt;br&gt;复用原生循环与统一工具&lt;br&gt;&lt;br&gt;Run 绑定合同与恢复兼容身份&lt;br&gt;&lt;br&gt;重建会话保留动作事实与预算" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="240" width="480" height="230" />
        </mxCell>
        <mxCell id="ov-finish" value="&lt;b&gt;3 交付核验&lt;/b&gt;&lt;br&gt;&lt;br&gt;精确成果版本 + 目标版本&lt;br&gt;&lt;br&gt;最新命令水位 + 真实动作回执&lt;br&gt;&lt;br&gt;只读任务可直接交付" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="240" width="480" height="230" />
        </mxCell>
        <mxCell id="ov-data" value="&lt;b&gt;有证据的分析输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1-A 有限固定本地输入已实现&lt;br&gt;&lt;br&gt;材料 / 日期 / 有效值 / 历史分别说明&lt;br&gt;&lt;br&gt;本地已读不等于远端全量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0ebfa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="580" width="480" height="230" />
        </mxCell>
        <mxCell id="ov-tools" value="&lt;b&gt;统一工具合同&lt;/b&gt;&lt;br&gt;&lt;br&gt;共享能力注册持有业务定义&lt;br&gt;&lt;br&gt;V1 校验实际序列化与消费一致&lt;br&gt;&lt;br&gt;全量 DTO / schema 生成按需后置" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0ebfa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="580" width="480" height="230" />
        </mxCell>
        <mxCell id="ov-actions" value="&lt;b&gt;需要业务写入时&lt;/b&gt;&lt;br&gt;&lt;br&gt;草稿 + 授权 + 来源条件检查&lt;br&gt;&lt;br&gt;持久意图 → 来源写入 → 回读&lt;br&gt;&lt;br&gt;镜像/索引失败不重放业务写入" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="580" width="480" height="230" />
        </mxCell>
        <mxCell id="ov-rules" value="&lt;b&gt;用户纠正 / 规则提案&lt;/b&gt;&lt;br&gt;&lt;br&gt;临时例外留 Work；长期要求分类&lt;br&gt;&lt;br&gt;明确授权 → 条件写入 → 回读&lt;br&gt;&lt;br&gt;规则不能扩大权限" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="920" width="480" height="230" />
        </mxCell>
        <mxCell id="ov-recover" value="&lt;b&gt;检查点与兼容恢复&lt;/b&gt;&lt;br&gt;&lt;br&gt;继续 / 显式迁移 / 重建会话 / 拒绝&lt;br&gt;&lt;br&gt;未知先核验，已知成功不重复&lt;br&gt;&lt;br&gt;跨版本清单与 Trace 配额见第 06 页" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="920" width="480" height="230" />
        </mxCell>
        <mxCell id="ov-undo" value="&lt;b&gt;请求撤销时&lt;/b&gt;&lt;br&gt;&lt;br&gt;新补偿 action，不 Pop 原账本&lt;br&gt;&lt;br&gt;核对后续编辑、权限及恢复条件&lt;br&gt;&lt;br&gt;沿同一动作执行与核验链" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="920" width="480" height="230" />
        </mxCell>
        <mxCell id="e-ov-goal-ov-run" source="ov-goal" target="ov-run" value="目标" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
