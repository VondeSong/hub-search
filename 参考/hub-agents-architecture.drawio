          <mxGeometry x="1344" y="155" width="310" height="58" as="geometry" />
        </mxCell>
        <mxCell id="en-contract" value="&lt;b&gt;① 合同单一来源｜7.2.1&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1：共享能力注册，真实序列化与 UI 消费一致，版本差异可识别。&lt;br&gt;&lt;br&gt;全量 DTO / schema / TS 生成暂缓，避免阻塞首个闭环。&lt;br&gt;&lt;br&gt;Schemars / ts-rs 仍为候选；采用时完成 O-24 / A-118。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="en-recovery" value="&lt;b&gt;② 跨版本恢复｜8.46&lt;/b&gt;&lt;br&gt;&lt;br&gt;检查点绑定 runtime、工具合同、提供方协议与策略版本。&lt;br&gt;&lt;br&gt;兼容继续 / 显式迁移 / 重建会话 / 不兼容；已知副作用不重放。&lt;br&gt;&lt;br&gt;借鉴 Temporal / LangGraph；O-23 · A-114。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;" vertex="1" parent="1">
          <mxGeometry x="610" y="270" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="en-storage" value="&lt;b&gt;③ 容量与 Trace｜8.47&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1：先测真实规模与边界，范围内可靠保存，超限保全已有成果。&lt;br&gt;&lt;br&gt;仅实际瓶颈触发载荷分离；采用引用须验证持久化、权限与缺失。&lt;br&gt;&lt;br&gt;V3：完整 pin / 回收与连续 Run；长期协作前退出 20 Run 上限。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;" vertex="1" parent="1">
          <mxGeometry x="1180" y="270" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="en-stream" value="&lt;b&gt;④ 实际来源读取证据｜4.8&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1 只对首个采用来源及操作核验读取、分页、历史与覆盖。&lt;br&gt;&lt;br&gt;缺口标 unknown；本地匹配不声称远端全量。&lt;br&gt;&lt;br&gt;全资源流重建按需后置；复用现有领域所有者。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="en-extract" value="&lt;b&gt;⑤ 单指标证据与质量｜7.6&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1 主睡眠最小字段；Unicode scalar 原文坐标、事件去重及修正。&lt;br&gt;&lt;br&gt;本指标人工真值核对 precision / recall，歧义不伪造数值。&lt;br&gt;&lt;br&gt;通用分块 / 多轮框架后置；实际需要才补场景子集。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;" vertex="1" parent="1">
          <mxGeometry x="610" y="690" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="en-chart" value="&lt;b&gt;⑥ 有限声明式图表｜7.7.1&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1-B/C：bar / line、同源表格、修订与报告依赖已接入 Recharts。&lt;br&gt;&lt;br&gt;剩余：抽取指标、原生视觉及重开链；导出条件进入，首次启用带保护。&lt;br&gt;&lt;br&gt;不承诺完整 Vega 兼容；A-121 按采用子集验收。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;" vertex="1" parent="1">
          <mxGeometry x="1180" y="690" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="en-tests" value="&lt;b&gt;⑦ 状态验证按风险引入｜14.12&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1 必需：当前采用状态的不变量、版本失效、晚到结果、重连、容量与故障回归。&lt;br&gt;&lt;br&gt;随机参考模型 / 全排列 / 跨版本矩阵暂缓；V2 复杂动作或 V3 控制恢复时进入。&lt;br&gt;&lt;br&gt;真实协议、真实模型与原生界面各自留证；确定性回放不代替模型质量。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="1620" height="240" as="geometry" />
        </mxCell>
        <mxCell id="en-adoption" value="&lt;b&gt;接续实施顺序｜13.11 / 14.11&lt;/b&gt;&lt;br&gt;&lt;br&gt;核对 A–H → 测实际规模 / 开销 → 一个指标接现有成果链 → Hub 重开与原生体验。&lt;br&gt;&lt;br&gt;正式运行前冻结 manifest、场景预算与逐项 3/3；导出和 blob 按条件进入。&lt;br&gt;&lt;br&gt;长期合同保留；V1 新增范围冻结，必要纠错原位记录。不以静态线索宣布性能根因或提速成绩。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;" vertex="1" parent="1">
          <mxGeometry x="40" y="1410" width="1620" height="210" as="geometry" />
        </mxCell>
        <mxCell id="en-e1" value="版本绑定" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6B7F99;strokeWidth=2;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="en-contract" target="en-recovery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en-e2" value="核验引用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6B7F99;strokeWidth=2;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="en-recovery" target="en-storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en-e3" value="同一接口合同" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6B7F99;strokeWidth=2;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="en-contract" target="en-stream">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en-e4" value="冻结输入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6B7F99;strokeWidth=2;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="en-stream" target="en-extract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en-e5" value="核验数据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6B7F99;strokeWidth=2;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="en-extract" target="en-chart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en-e6" value="受控载荷引用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6B7F99;strokeWidth=2;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="en-storage" target="en-chart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en-e7" value="实际状态转换 + 故障注入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6B7F99;strokeWidth=2;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="en-extract" target="en-tests">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v1-status-nav" value="&lt;b&gt;07 V1 进度与体验验收 →&lt;/b&gt;&lt;br&gt;A–H 当前证据 · 首版必需 / 暂缓 · 体验目标 · 十个代表用例" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#E7F0FC;" vertex="1" parent="1" link="data:page/id,hub-agents-v1-status">
          <mxGeometry x="40" y="1660" width="1620" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hub-agents-v1-status" name="07 V1 进度与体验验收 · 历史1.14">
    <mxGraphModel dx="1700" dy="1980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1980" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1-title" value="&lt;b&gt;V1验收设计与历史阶段状态｜基线1.14（2026-10-23）。当前C9出口、失败与已接受范围见08页及实施记录。&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=24;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#E7F0FC;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v1-nav-0" value="01 原详图 · 基线 1.14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F1F5F9;" vertex="1" parent="1" link="data:page/id,hub-agents-current">
          <mxGeometry x="40" y="160" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v1-nav-1" value="02 执行总览 · 1.14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F1F5F9;" vertex="1" parent="1" link="data:page/id,hub-agents-overview">
          <mxGeometry x="590" y="160" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v1-nav-2" value="03 目标与所有权 · 1.14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F1F5F9;" vertex="1" parent="1" link="data:page/id,hub-agents-contracts">
          <mxGeometry x="1140" y="160" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v1-nav-3" value="04 数据与成果 · 1.14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F1F5F9;" vertex="1" parent="1" link="data:page/id,hub-agents-analysis">
          <mxGeometry x="40" y="225" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v1-nav-4" value="05 交付与验收 · 1.14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F1F5F9;" vertex="1" parent="1" link="data:page/id,hub-agents-delivery">
          <mxGeometry x="590" y="225" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v1-nav-5" value="06 工程合同与成熟方案 · 1.14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F1F5F9;" vertex="1" parent="1" link="data:page/id,hub-agents-engineering">
          <mxGeometry x="1140" y="225" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="v1-progress" value="&lt;b&gt;当前进度：接续 A–H；源码、验证与发布分开&lt;/b&gt;&lt;br&gt;&lt;br&gt;A 固定输入；B 图表修订；C 报告依赖；D 真实模型单例；E 目标版本；F 完成判定；G 任务依赖；H 目标解释修订。&lt;br&gt;&lt;br&gt;D 两轮约 48 / 43 秒，累计输入约 150k / 155k；首事件计时缺失。根因未确认，当前原生体验及正式基准仍未通过。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F0FDF4;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="1620" height="190" as="geometry" />
        </mxCell>
        <mxCell id="v1-required" value="&lt;b&gt;V1 必需：一个有用闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;固定输入与授权；材料、日期、有效值、历史四层覆盖。&lt;br&gt;&lt;br&gt;统计 + 主睡眠最小字段；原文坐标、单位、事件去重、排除及修正。&lt;br&gt;&lt;br&gt;复用同一图表 / 报告修订；旧报告失效；Hub 内保存、重开及检查。&lt;br&gt;&lt;br&gt;必要证据持久化、容量失败保全、版本检查与基本状态回读。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#EDF4FF;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="520" height="390" as="geometry" />
        </mxCell>
        <mxCell id="v1-deferred" value="&lt;b&gt;暂缓 / 条件项：有依据再进入&lt;/b&gt;&lt;br&gt;&lt;br&gt;条件项：本地导出按明确需求；blob 分离按实测容量瓶颈。&lt;br&gt;&lt;br&gt;暂缓：全域表迁移、全量合同生成、通用抽取；随机状态机与完整跨版本恢复。&lt;br&gt;&lt;br&gt;高级压缩 / 看门狗、任意脚本 / SQL / 办公格式、后台及多 Agent。&lt;br&gt;&lt;br&gt;已有能力保留；权限、版本、证据与必要故障回归不暂缓。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#FFF7ED;" vertex="1" parent="1">
          <mxGeometry x="590" y="540" width="520" height="390" as="geometry" />
        </mxCell>
        <mxCell id="v1-next" value="&lt;b&gt;接续实施：先测，再闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 核定 A–H；测笔记 / 日期段 / 字符 / 字节规模与各段耗时、输入开销。&lt;br&gt;&lt;br&gt;② 主睡眠最小数据集 → 现有图表 / 报告，闭合纠正链。&lt;br&gt;&lt;br&gt;③ 历史证据、Hub 内重开与原生界面；按实测处理容量。&lt;br&gt;&lt;br&gt;④ 冻结 manifest 与预算；十用例逐项 3/3，质量与体验同时通过。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F5F3FF;" vertex="1" parent="1">
          <mxGeometry x="1140" y="540" width="520" height="390" as="geometry" />
        </mxCell>
        <mxCell id="v1-latency" value="&lt;b&gt;体验分层：均未实测通过&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hub 硬门：本地接收 ≤300 ms；事件到 UI 尾部 ≤250 ms；持久化 / 渲染预算测后冻结。&lt;br&gt;&lt;br&gt;提供方等待与工具执行分段记录；同条件对照，整轮耗时不全归模型。&lt;br&gt;&lt;br&gt;端到端体验仍须放行：按规模 / 模型冻结预算；旧 5 / 10 / 30 / 20 s 及 100k 为探索目标。&lt;br&gt;&lt;br&gt;输入总量 / 缓存 / 非缓存 / 输出分列；费用未知不填 0；180 s 只是小样本执行护栏。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#EDF4FF;" vertex="1" parent="1">
          <mxGeometry x="40" y="970" width="790" height="340" as="geometry" />
        </mxCell>
        <mxCell id="v1-quality" value="&lt;b&gt;行为与证据：速度不能抵偿错误&lt;/b&gt;&lt;br&gt;&lt;br&gt;可恢复读取失败最多 2 次额外尝试；同参无效重试 ≤1 次。撤权、永久失败及未知写入正确停止或核验。&lt;br&gt;&lt;br&gt;要求、成果历史及状态保留；重连一致。原生图 / 表 / 引用可读、键盘可用。&lt;br&gt;&lt;br&gt;每项 3/3；2/3 不通过，不宣称稳定 90%。少于 20 次用最大值核对尾部，不标 P95。&lt;br&gt;&lt;br&gt;全部失败 / 超时保留；缺预算或必要证据未验证，不能事后调门槛追认。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F0FDF4;" vertex="1" parent="1">
          <mxGeometry x="870" y="970" width="790" height="340" as="geometry" />
        </mxCell>
        <mxCell id="v1-cases" value="&lt;b&gt;十个代表用例｜14.11.5&lt;/b&gt;&lt;br&gt;&lt;br&gt;01 简单解释 / 改写　　02 两份资料查证与无答案　　03 月度统计、重复与缺月　　04 主睡眠最小抽取　　05 纠正值 / 日期&lt;br&gt;&lt;br&gt;06 同一成果改变口径　　07 可恢复故障与永久拒绝　　08 UI 重开及快照失效　　09 真实容量、阈值 / 写盘失败　　10 追加“只预览”后重开 Hub 成果与历史&lt;br&gt;&lt;br&gt;模型自主选择路径；导出启用才追加独立子场景。代表规模必须填实值，不能拿三天夹具代表实际日记。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="1350" width="1620" height="230" as="geometry" />
        </mxCell>
        <mxCell id="v1-boundary" value="&lt;b&gt;交付边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1 必需 Hub 内持久成果。导出条件进入，首次启用即有目标授权、覆盖保护、意图 / 回执、回读与未知核验；来源写回归 V2。源码和单例不能代替原生体验。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#FFF7ED;" vertex="1" parent="1">
          <mxGeometry x="40" y="1620" width="1620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v1-evidence" value="&lt;b&gt;证据导航&lt;/b&gt;&lt;br&gt;&lt;br&gt;实施记录 9.50–9.57 及各轮 artifacts。先测规模、上下文和复用资格，不预判根因或“42 → 10 秒”；一次只改一类因素，保留原始失败和 unknown。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;fillColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="40" y="1790" width="1620" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram id="hub-agents-current-115" name="08 当前合同与范围 · 1.16"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1640" pageHeight="1000" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="cur-title" value="&lt;b&gt;当前架构1.16 · 原生问答优化9.257&lt;/b&gt;&lt;br&gt;0.16.392 / DB85开发验收：普通回答、精确引用、业务成果分开；核心CN历史交付继续有效。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1560" height="100" as="geometry" /></mxCell><mxCell id="cur-v1" value="&lt;b&gt;V1 接受限制交付&lt;/b&gt;&lt;br&gt;分析、纠正与成果闭环成立。&lt;br&gt;C9原成绩27通过/3未通过；性能与输入例外保留。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="296" height="180" as="geometry" /></mxCell><mxCell id="cur-v2" value="&lt;b&gt;V2 首个来源完成&lt;/b&gt;&lt;br&gt;本地Obsidian报告追加、冲突、未知核验、条件撤回。&lt;br&gt;A-93仅补同步恢复已验证。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="356" y="170" width="296" height="180" as="geometry" /></mxCell><mxCell id="cur-v3" value="&lt;b&gt;V3 限定完成＋预算与上下文入口&lt;/b&gt;&lt;br&gt;386同线程恢复轮按增量计量，结算与重开一致。&lt;br&gt;失败保留最新用量快照；旧未知预留不清零。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="672" y="170" width="296" height="180" as="geometry" /></mxCell><mxCell id="cur-v4" value="&lt;b&gt;V4 部分完成&lt;/b&gt;&lt;br&gt;能力准入、计量及显式Codex降级已验证。&lt;br&gt;复杂DeepSeek、新来源、图像、后台仍开放。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="988" y="170" width="296" height="180" as="geometry" /></mxCell><mxCell id="cur-v5" value="&lt;b&gt;V5 首个代表范围完成&lt;/b&gt;&lt;br&gt;Obsidian主睡眠两周期专题。&lt;br&gt;固定方法、纠正、包管理与外部Codex已有分析互通。&lt;br&gt;9.187限定退出；不外推全部指标/来源。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1304" y="170" width="296" height="180" as="geometry" /></mxCell><mxCell id="cur-flow-0" source="cur-v1" target="cur-v2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cur-flow-1" source="cur-v2" target="cur-v3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cur-flow-2" source="cur-v3" target="cur-v4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cur-flow-3" source="cur-v4" target="cur-v5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cur-codex" value="&lt;b&gt;官方Codex App Server＋Hub资料与业务边界&lt;/b&gt;&lt;br&gt;普通问答：原生最终消息及文字增量直接呈现。&lt;br&gt;精确引用：轻量绑定本轮引文，发布时再核验来源。&lt;br&gt;业务成果：按需读取复杂参数，校验真实草稿及回执。&lt;br&gt;公开搜索、提问/回答、原图、预算与恢复沿用。&lt;br&gt;T3参考界面与事件机制；Hub不另造通用推理流程。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="760" height="205" as="geometry" /></mxCell><mxCell id="cur-deepseek" value="&lt;b&gt;DeepSeek：限定文本成功，复杂工具链未通过&lt;/b&gt;&lt;br&gt;344同Work文本修订固定2/2，345完整失败回执计量结算通过。&lt;br&gt;最后R2/2用args代替arguments，0通过/1失败/2未执行封存。&lt;br&gt;346隐藏并拒绝冻结范围的新对话草稿操作；显式选Codex继续，同事项原额度/旧失败保留。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="840" y="390" width="760" height="205" as="geometry" /></mxCell><mxCell id="cur-gates" value="&lt;b&gt;不变的保护与计量边界&lt;/b&gt;&lt;br&gt;预算保留旧消费和未知预留；追加只提高累计上限。&lt;br&gt;压缩/重开不清零；窗口报告不是账单硬封顶。&lt;br&gt;原图授权独立、最多2张/每张256KiB；来源与业务回执保持。&lt;br&gt;Windows认证副本随最后句柄关闭删除，强退不依赖再继续。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="760" height="190" as="geometry" /></mxCell><mxCell id="cur-open" value="&lt;b&gt;MCP：预设＋自定义匿名远程服务&lt;/b&gt;&lt;br&gt;390桌面：添加、发现、信任/选择、应用、查询、撤销通过。&lt;br&gt;Microsoft Learn代表案例；结果与撤销状态重开保留。&lt;br&gt;只读为服务声明，非远端副作用或DNS隔离。&lt;br&gt;OAuth/stdio/写插件按需；手机无Agent，Notion暂停。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="840" y="635" width="760" height="190" as="geometry" /></mxCell><mxCell id="cur-links" value="&lt;b&gt;当前实施与证据 · 架构/实施9.257&lt;/b&gt;&lt;br&gt;真实日记总结与追问、普通规划、联网问答和草稿预览；逐项结果见交付报告。&lt;br&gt;本轮使用开发版，不打包；用户知识库规则、授权、来源版本与业务回执保护保留。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="865" width="1560" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram>
