        <mxCell id="p3-nav-0" value="&lt;b&gt;01 原详图&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=16;fontFamily=Microsoft YaHei;" vertex="1" parent="1" link="data:page/id,hub-agents-current">
          <mxGeometry as="geometry" x="40" y="155" width="310" height="48" />
        </mxCell>
        <mxCell id="p3-nav-1" value="&lt;b&gt;02 执行总览&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=16;fontFamily=Microsoft YaHei;" vertex="1" parent="1" link="data:page/id,hub-agents-overview">
          <mxGeometry as="geometry" x="366" y="155" width="310" height="48" />
        </mxCell>
        <mxCell id="p3-nav-2" value="&lt;b&gt;03 目标与所有权&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=16;fontFamily=Microsoft YaHei;" vertex="1" parent="1" link="data:page/id,hub-agents-contracts">
          <mxGeometry as="geometry" x="692" y="155" width="310" height="48" />
        </mxCell>
        <mxCell id="p3-nav-3" value="&lt;b&gt;04 数据与成果&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f0fc;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=16;fontFamily=Microsoft YaHei;" vertex="1" parent="1" link="data:page/id,hub-agents-analysis">
          <mxGeometry as="geometry" x="1018" y="155" width="310" height="48" />
        </mxCell>
        <mxCell id="p3-nav-4" value="&lt;b&gt;05 交付与验收&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=16;fontFamily=Microsoft YaHei;" vertex="1" parent="1" link="data:page/id,hub-agents-delivery">
          <mxGeometry as="geometry" x="1344" y="155" width="310" height="48" />
        </mxCell>
        <mxCell id="an-snapshot" value="&lt;b&gt;固定有界输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1-A：成员 / 版本 / 历史正文&lt;br&gt;&lt;br&gt;授权、到期和缺失须明确&lt;br&gt;&lt;br&gt;材料 / 日期 / 值 / 历史覆盖分开" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0ebfa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="240" width="480" height="230" />
        </mxCell>
        <mxCell id="an-extract" value="&lt;b&gt;主睡眠：最小数据集｜7.6.1&lt;/b&gt;&lt;br&gt;&lt;br&gt;原值 / 小时数 / 日期 / 原文坐标&lt;br&gt;&lt;br&gt;事件身份 / 排除 / 修订及纠正来源&lt;br&gt;&lt;br&gt;模糊值保留并排除，通用计算后置" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0ebfa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="240" width="480" height="230" />
        </mxCell>
        <mxCell id="an-check" value="&lt;b&gt;重复与字段质量&lt;/b&gt;&lt;br&gt;&lt;br&gt;日期段合并不等于事件去重&lt;br&gt;&lt;br&gt;重复正文与事件键分别核验&lt;br&gt;&lt;br&gt;无法确定保留歧义，不自动补零" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0ebfa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="240" width="480" height="230" />
        </mxCell>
        <mxCell id="an-example" value="&lt;b&gt;模糊值的处理&lt;/b&gt;&lt;br&gt;&lt;br&gt;“六个多小时”不自动填 6.5&lt;br&gt;&lt;br&gt;“精力一般”不默认映射 3 分&lt;br&gt;&lt;br&gt;午睡与夜间睡眠分别建事件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="570" width="480" height="230" />
        </mxCell>
        <mxCell id="an-compute" value="&lt;b&gt;4 确定性计算&lt;/b&gt;&lt;br&gt;&lt;br&gt;记录纳入数、有效数和分母定义&lt;br&gt;&lt;br&gt;保留方法与输入修订&lt;br&gt;&lt;br&gt;异常不能静默补零或抽样冒充全量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="570" width="480" height="230" />
        </mxCell>
        <mxCell id="an-artifact" value="&lt;b&gt;同一成果持续修订&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1-B/C：图表修订与报告依赖&lt;br&gt;&lt;br&gt;有限 bar / line + 同源表格&lt;br&gt;&lt;br&gt;已有 Recharts；扩展抽取指标待接" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="570" width="480" height="230" />
        </mxCell>
        <mxCell id="an-correct" value="&lt;b&gt;用户纠正 / 来源或方法变化&lt;/b&gt;&lt;br&gt;&lt;br&gt;生成新数据修订，不悄悄改原文&lt;br&gt;&lt;br&gt;按依赖标 stale 并重新计算&lt;br&gt;&lt;br&gt;首期可保守重算，不能混用新旧值" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="900" width="480" height="230" />
        </mxCell>
        <mxCell id="an-validate" value="&lt;b&gt;预览、检查与重开&lt;/b&gt;&lt;br&gt;&lt;br&gt;数值检查已有；原生视觉仍开放&lt;br&gt;&lt;br&gt;表格、图表、报告引用同一版本&lt;br&gt;&lt;br&gt;Hub 内可重新打开、检查并修订" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="900" width="480" height="230" />
        </mxCell>
        <mxCell id="an-publish" value="&lt;b&gt;发布 / 按授权保存&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1：Hub 内持久成果及历史版本&lt;br&gt;&lt;br&gt;导出按条件；授权 / 回执 / 核验&lt;br&gt;&lt;br&gt;V2 来源写回；预览不冒充保存" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="900" width="480" height="230" />
        </mxCell>
        <mxCell id="e-an-snapshot-an-extract" source="an-snapshot" target="an-extract" value="原文" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-an-extract-an-check" source="an-extract" target="an-check" value="候选" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-an-check-an-compute" source="an-check" target="an-compute" value="冻结输入" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-an-compute-an-artifact" source="an-compute" target="an-artifact" value="计算结果" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-an-artifact-an-validate" source="an-artifact" target="an-validate" value="成果修订" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-an-validate-an-publish" source="an-validate" target="an-publish" value="已检版本" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="an-note" value="&lt;b&gt;成果合同：读取 → 创建 / 修订 → 检查 → 交付，模型按任务选择&lt;/b&gt;&lt;br&gt;&lt;br&gt;A–C 有定向证据，D 有真实模型单例；E–H 增加目标、完成、任务依赖及解释修订。历史结果保留，不冒充整体验收。&lt;br&gt;&lt;br&gt;颜色调整与口径变化分别失效；新数据集需可追溯到原文。一个指标先闭环，通用框架暂缓。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=17;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1240" width="1620" height="135" />
        </mxCell>
        <mxCell id="engineering-nav" value="&lt;b&gt;06 工程合同与成熟方案 →&lt;/b&gt;&lt;br&gt;兼容恢复 · Trace 资源 · 读取证据 · 合同生成 · 抽取坐标 · 图表 · 状态机测试" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#93A9C4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#203149;" vertex="1" parent="1" link="data:page/id,hub-agents-engineering">
