        <mxCell id="e-ct-task-ct-finish" source="ct-task" target="ct-finish" value="证据" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-ct-run-ct-store" source="ct-run" target="ct-store" value="状态/意图" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-ct-store-ct-ui" source="ct-store" target="ct-ui" value="提交投影" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e-ct-task-ct-store" source="ct-task" target="ct-store" value="引用事实" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="ct-note" value="&lt;b&gt;示例：分析 + 图表 + 保存，追加“只统计 2025，保存前先看”&lt;/b&gt;&lt;br&gt;&lt;br&gt;产生新目标版本；旧成果按依赖失效；尚未派发保存停止/重判资格。预览完成仍须保留保存未完成项。&lt;br&gt;&lt;br&gt;已发生的保存不会被改写为未执行。新的修改或补偿走正式动作合同。A-100 / A-101 / A-108 / A-109。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=17;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1240" width="1620" height="135" />
