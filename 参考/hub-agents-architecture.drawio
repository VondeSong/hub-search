        <mxCell id="ct-command" value="&lt;b&gt;用户命令与目标&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1-H：带来源的目标解释修订&lt;br&gt;&lt;br&gt;保留原始要求、约束及解释历史&lt;br&gt;&lt;br&gt;并发 / 幂等校验；完整控制属 V3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="240" width="480" height="230" />
        </mxCell>
        <mxCell id="ct-task" value="&lt;b&gt;Task 与完成证据&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1-G：层级 / 依赖 / 重验证已实现&lt;br&gt;&lt;br&gt;保留用户要求，证据绑定实际版本&lt;br&gt;&lt;br&gt;已有定向证据；模型采用仍待验证" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="240" width="480" height="230" />
        </mxCell>
        <mxCell id="ct-finish" value="&lt;b&gt;DeliveryAssessment&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1-E/F：目标版本与逐项完成判定&lt;br&gt;&lt;br&gt;最终发布再核对目标 / 成果 / 任务&lt;br&gt;&lt;br&gt;Run completed 不代替 Work fulfilled" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="240" width="480" height="230" />
        </mxCell>
        <mxCell id="ct-run" value="&lt;b&gt;Run / 执行兼容身份&lt;/b&gt;&lt;br&gt;&lt;br&gt;Runner 唯一推进运行与检查点&lt;br&gt;&lt;br&gt;绑定工具合同、协议及运行版本&lt;br&gt;&lt;br&gt;恢复保留命令、动作身份与累计预算" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="570" width="480" height="230" />
        </mxCell>
        <mxCell id="ct-store" value="&lt;b&gt;提交与 Trace 存储&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1 先测容量；载荷分离按需进入&lt;br&gt;&lt;br&gt;V3：完整 pin / 回收 / 生命周期&lt;br&gt;&lt;br&gt;回执写盘失败 → 停发并核验未知" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="570" width="480" height="230" />
        </mxCell>
        <mxCell id="ct-ui" value="&lt;b&gt;UI 消费已提交状态&lt;/b&gt;&lt;br&gt;&lt;br&gt;正式 view 与组件已有定向证据&lt;br&gt;&lt;br&gt;V1 校验实际合同；全量生成后置&lt;br&gt;&lt;br&gt;缺口不得伪造补平，原生体验另验" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="570" width="480" height="230" />
        </mxCell>
        <mxCell id="ct-scratch" value="&lt;b&gt;Scratchpad 与 Context View&lt;/b&gt;&lt;br&gt;&lt;br&gt;目标/进度投影 Work，不另写 done&lt;br&gt;&lt;br&gt;观察、假设、结论保留证据和状态&lt;br&gt;&lt;br&gt;压缩只改模型表示，Full Trace 保留" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="900" width="480" height="230" />
        </mxCell>
        <mxCell id="ct-budget" value="&lt;b&gt;容量与累计预算&lt;/b&gt;&lt;br&gt;&lt;br&gt;V1：承诺范围内保全，超限明示&lt;br&gt;&lt;br&gt;20 Run 限制仍在；长期协作前退出&lt;br&gt;&lt;br&gt;V3 完整回收；新 Run 不洗掉累计预算" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="900" width="480" height="230" />
        </mxCell>
        <mxCell id="ct-invariant" value="&lt;b&gt;必须保持的不变量&lt;/b&gt;&lt;br&gt;&lt;br&gt;用户要求不因清单编辑消失&lt;br&gt;&lt;br&gt;原文/成果/动作/事件身份可关联&lt;br&gt;&lt;br&gt;黑板、UI、watchdog 不另造业务真源" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1180" y="900" width="480" height="230" />
        </mxCell>
        <mxCell id="e-ct-command-ct-task" source="ct-command" target="ct-task" value="要求" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
