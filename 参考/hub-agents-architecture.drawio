        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-title" value="&lt;b&gt;从来源数据到持久成果、再到原文的可检查闭环｜历史基线1.14。当前实现证据见08页及文档0.5。&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f0fc;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=24;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1620" height="120" />
