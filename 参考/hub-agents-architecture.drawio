        <mxCell id="p4-nav-3" value="&lt;b&gt;04 数据与成果&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=16;fontFamily=Microsoft YaHei;" vertex="1" parent="1" link="data:page/id,hub-agents-analysis">
          <mxGeometry as="geometry" x="1018" y="155" width="310" height="48" />
        </mxCell>
        <mxCell id="p4-nav-4" value="&lt;b&gt;05 交付与验收&lt;/b&gt;&lt;br&gt;&lt;br&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f0fc;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=16;fontFamily=Microsoft YaHei;" vertex="1" parent="1" link="data:page/id,hub-agents-delivery">
          <mxGeometry as="geometry" x="1344" y="155" width="310" height="48" />
        </mxCell>
        <mxCell id="dv-v1" value="&lt;b&gt;V1 可检查分析成果&lt;/b&gt;&lt;br&gt;&lt;br&gt;固定输入 + 统计 / 一个抽取指标&lt;br&gt;&lt;br&gt;同一图表与报告修订&lt;br&gt;&lt;br&gt;Hub 内持久成果 + 重开与修订&lt;br&gt;&lt;br&gt;质量与体验同时通过" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=17;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="240" width="375" height="260" />
        </mxCell>
        <mxCell id="dv-v2" value="&lt;b&gt;V2 来源保存闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;先贯通一种来源，再扩展组合&lt;br&gt;&lt;br&gt;条件写入、回读、冲突和未知恢复&lt;br&gt;&lt;br&gt;首次写入即有持久意图/回执" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=17;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="455" y="240" width="375" height="260" />
        </mxCell>
        <mxCell id="dv-e1" source="dv-v1" target="dv-v2" value="增量" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="dv-v3" value="&lt;b&gt;V3 长任务连续协作&lt;/b&gt;&lt;br&gt;&lt;br&gt;暂停 / 追加 / 跨重启&lt;br&gt;&lt;br&gt;跨版本兼容与会话重建&lt;br&gt;&lt;br&gt;Trace 回收与 Work 连续性&lt;br&gt;&lt;br&gt;预算、命令、副作用不丢失" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0ebfa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=17;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="240" width="375" height="260" />
        </mxCell>
        <mxCell id="dv-e2" source="dv-v2" target="dv-v3" value="增量" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="dv-v4" value="&lt;b&gt;V4 扩大适用范围&lt;/b&gt;&lt;br&gt;&lt;br&gt;逐提供方、逐业务验证能力&lt;br&gt;&lt;br&gt;后台触发按需求启用&lt;br&gt;&lt;br&gt;不把 Codex 成绩当全模型保证" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=17;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1285" y="240" width="375" height="260" />
        </mxCell>
        <mxCell id="dv-e3" source="dv-v3" target="dv-v4" value="增量" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#607b9e;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="dv-gates" value="&lt;b&gt;V1 必需与条件项&lt;/b&gt;&lt;br&gt;&lt;br&gt;必需：范围 / 版本 / 证据 / 重开&lt;br&gt;&lt;br&gt;先测：代表规模 / 容量 / 各段开销&lt;br&gt;&lt;br&gt;条件：本地导出 / blob 分离&lt;br&gt;&lt;br&gt;暂缓：通用框架与完整长期恢复" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="590" width="510" height="320" />
        </mxCell>
        <mxCell id="dv-eval" value="&lt;b&gt;分轨验证与代表用例&lt;/b&gt;&lt;br&gt;&lt;br&gt;UX-01–10，每项 3 次且 3/3&lt;br&gt;&lt;br&gt;2/3 不通过；确定性违规阻断&lt;br&gt;&lt;br&gt;小样本不证明稳定 90% 成功率&lt;br&gt;&lt;br&gt;宿主硬门 + 冻结端到端预算" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="590" width="510" height="320" />
        </mxCell>
        <mxCell id="dv-evidence" value="&lt;b&gt;当前证据与开放项&lt;/b&gt;&lt;br&gt;&lt;br&gt;A–H：源码及各自定向证据&lt;br&gt;&lt;br&gt;D：单提供方 / 单例真实模型&lt;br&gt;&lt;br&gt;原生视觉 / 正式体验未验；导出条件进入&lt;br&gt;&lt;br&gt;源码交付不等于已安装或发布" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="590" width="500" height="320" />
        </mxCell>
        <mxCell id="dv-closure" value="&lt;b&gt;保持唯一实施账本与证据边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;0.5 导航至实施记录 9.50–9.57；13.11 明确首版范围；14.11 定义质量与体验双门。&lt;br&gt;&lt;br&gt;复用现有 Runner、能力注册、store 和 Recharts；不新增另一条流水线，不回退已实现能力。&lt;br&gt;&lt;br&gt;暂缓项有重新进入条件；旧失败与未知项继续保留，不能在结果出来后降低门槛追认通过。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#93a9c4;align=left;verticalAlign=top;spacing=18;fontSize=19;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1000" width="1620" height="220" />
        </mxCell>
