{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hub",
  "version": "0.16.396",
  "identifier": "com.craftsearch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hub",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https: http://craft-media.localhost craft-media:",
        "media-src": "'self' http://craft-media.localhost craft-media:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../.local/memory-distribution/windows-x64/memory-runtime.zip": "memory-runtime.zip",
      "../.local/memory-distribution/windows-x64/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../assets/third-party/shared-memory/BGE-LICENSE.txt": "BGE-LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "host": "oauth",
          "pathPrefix": [
            "/callback"
          ],
          "scheme": [
            "hub-craft-search"
          ]
        }
      ]
    }
  }
}
