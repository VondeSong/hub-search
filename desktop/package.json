{
  "name": "desktop",
  "private": true,
  "version": "0.16.396",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:android": "vite --config vite.android.config.ts",
    "android:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-dev.ps1",
    "build": "tsc && vite build",
    "test": "vitest run --dir src",
    "test:ci": "vitest run --dir src --pool=forks --maxWorkers=1",
    "test:rust": "node scripts/test-rust.mjs -- --test-threads=1",
    "test:tdl:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-tdl-gui-transport.ps1",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "npm run test:ci && npm run test:rust && npm run format:check && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:portable": "tauri build --no-bundle --features custom-protocol && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "katex": "^0.18.1",
    "lucide-react": "^1.26.0",
    "motion": "^13.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
